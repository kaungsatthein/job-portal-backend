    "/auth/google": {
      "get": {
        "operationId": "AuthController_googleAuth",
        "parameters": [
          {
            "name": "role",
            "required": false,
            "in": "query",
            "description": "User role (admin, recruiter, researcher). Defaults to researcher.",
            "schema": {
              "enum": [
                "admin",
                "recruiter",
                "researcher"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
