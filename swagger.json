        "name": "Authorization",
        "type": "http",
        "in": "Header"
      }
    },
    "schemas": {
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "Admin@123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateIndustryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the industry",
            "example": "Information Technology"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateIndustryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the industry",
            "example": "Information Technology"
          }
        }
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Company name"
          },
          "industryId": {
            "type": "string",
            "description": "Industry ID"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Company name"
          },
          "industryId": {
            "type": "string",
            "description": "Industry ID"
          }
        }
      },
      "CreateJobPostingDto": {
        "type": "object",
        "properties": {
          "recruiterId": {
            "type": "string",
            "description": "Recruiter ID"
          },
          "companyId": {
            "type": "string",
            "description": "Company ID"
          },
          "title": {
            "type": "string",
            "description": "Job title"
          },
          "description": {
            "type": "string",
            "description": "Job description"
          },
          "jobType": {
            "type": "string",
            "description": "Job type",
            "enum": [
              "fulltime",
              "parttime",
              "contract"
            ]
          },
          "location": {
            "type": "string",
            "description": "Job location"
          },
          "salaryRange": {
            "type": "string",
            "description": "Salary range"
          },
          "status": {
            "type": "string",
            "description": "Job status",
            "enum": [
              "open",
              "closed",
              "pending"
            ]
          }
        },
        "required": [
          "recruiterId",
          "companyId",
          "title",
          "description",
          "jobType"
        ]
      },
      "UpdateJobPostingDto": {
        "type": "object",
        "properties": {
          "recruiterId": {
            "type": "string",
            "description": "Recruiter ID"
          },
          "companyId": {
            "type": "string",
            "description": "Company ID"
          },
          "title": {
            "type": "string",
            "description": "Job title"
          },
          "description": {
            "type": "string",
            "description": "Job description"
          },
          "jobType": {
            "type": "string",
            "description": "Job type",
            "enum": [
              "fulltime",
              "parttime",
              "contract"
            ]
          },
          "location": {
            "type": "string",
            "description": "Job location"
          },
          "salaryRange": {
            "type": "string",
            "description": "Salary range"
          },
          "status": {
            "type": "string",
            "description": "Job status",
            "enum": [
              "open",
              "closed",
              "pending"
            ]
          }
        }
      },
      "CreateApplicationDto": {
        "type": "object",
        "properties": {
          "researcherId": {
            "type": "string",
            "description": "ID of the researcher applying",
            "example": "uuid-of-researcher"
          },
          "jobId": {
            "type": "string",
            "description": "ID of the job posting",
            "example": "uuid-of-job-posting"
          },
          "status": {
            "type": "string",
            "description": "Initial status of the application",
            "enum": [
              "submitted",
              "reviewed",
              "accepted",
              "rejected"
            ],
            "example": "submitted"
          }
        },
        "required": [
          "researcherId",
          "jobId"
        ]
      },
      "UpdateApplicationDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateApplicationStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "reviewed",
              "accepted",
              "rejected"
            ],
            "example": "reviewed",
            "description": "Update application status"
          }
        },
        "required": [
          "status"
        ]
      }
    }
