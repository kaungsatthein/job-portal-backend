        "operationId": "AuthController_googleAuthRedirect",
        "parameters": [
          {
            "name": "role",
            "required": false,
            "in": "query",
            "description": "User role sent from frontend during OAuth initiation. Defaults to researcher.",
            "schema": {
              "enum": [
                "admin",
                "recruiter",
                "researcher"
              ],
              "type": "string"
            }
          }
